# Environment variables file
# 중요: 이 파일은 비밀번호, 비밀키 등 민감한 정보를 포함하고 있습니다.
# 절대로 Git 저장소에 커밋해서는 안 됩니다.
.env

# IDE-specific files and directories
# IntelliJ
.idea/
*.iml

# Eclipse
.classpath
.project
.settings/

# Build artifacts from Gradle and IDEs
build/
.gradle/
out/

# Log files
*.log

# Compiled Java classes
*.class

# Package files
*.jar
*.war
*.ear

# Operating System generated files
.DS_Store
Thumbs.db
